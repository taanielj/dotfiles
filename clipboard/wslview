#!/bin/sh
# wslview for WSL, replacing wslu (gone upstream, not in Ubuntu 26.04); nvim's vim.ui.open looks for this name.
# Local paths become Windows paths, URLs pass through. explorer.exe exits 1 even when it opens.
[ $# -eq 1 ] || { echo "usage: wslview <url-or-path>" >&2; exit 2; }
target=$1
[ -e "$target" ] && target=$(wslpath -w "$target")
cd /mnt/c 2>/dev/null # explorer.exe warns when started from a Linux directory
explorer.exe "$target"
exit 0
